{
  "$defs": {
    "ActionClip": {
      "additionalProperties": false,
      "description": "An action from the action library placed on the NLA timeline.",
      "properties": {
        "action_id": {
          "pattern": "^[a-z][a-z0-9_]{1,47}$",
          "title": "Action Id",
          "type": "string"
        },
        "start_frame": {
          "minimum": 1,
          "title": "Start Frame",
          "type": "integer"
        },
        "end_frame": {
          "minimum": 1,
          "title": "End Frame",
          "type": "integer"
        },
        "speed": {
          "default": 1.0,
          "exclusiveMinimum": 0.1,
          "maximum": 4,
          "title": "Speed",
          "type": "number"
        },
        "blend_in": {
          "default": 6,
          "maximum": 48,
          "minimum": 0,
          "title": "Blend In",
          "type": "integer"
        }
      },
      "required": [
        "action_id",
        "start_frame",
        "end_frame"
      ],
      "title": "ActionClip",
      "type": "object"
    },
    "Camera": {
      "additionalProperties": false,
      "properties": {
        "shot_size": {
          "$ref": "#/$defs/ShotSize",
          "default": "medium"
        },
        "lens_mm": {
          "default": 35,
          "maximum": 300,
          "minimum": 8,
          "title": "Lens Mm",
          "type": "number"
        },
        "look_at": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{1,47}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Look At"
        },
        "look_at_height": {
          "default": 1.3,
          "maximum": 10,
          "minimum": 0,
          "title": "Look At Height",
          "type": "number"
        },
        "keys": {
          "items": {
            "$ref": "#/$defs/CameraKey"
          },
          "minItems": 1,
          "title": "Keys",
          "type": "array"
        },
        "dof_enabled": {
          "default": true,
          "title": "Dof Enabled",
          "type": "boolean"
        },
        "focus_target": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{1,47}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Focus Target"
        },
        "fstop": {
          "default": 2.8,
          "maximum": 32,
          "minimum": 0.5,
          "title": "Fstop",
          "type": "number"
        },
        "handheld_shake": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Handheld Shake",
          "type": "number"
        },
        "framing": {
          "anyOf": [
            {
              "$ref": "#/$defs/Framing"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "clip_start_m": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0.001,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Start M"
        },
        "clip_end_m": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip End M"
        },
        "focus_distance_m": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 0.05,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Focus Distance M"
        }
      },
      "required": [
        "keys"
      ],
      "title": "Camera",
      "type": "object"
    },
    "CameraKey": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "minimum": 1,
          "title": "Frame",
          "type": "integer"
        },
        "location": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Location",
          "type": "array"
        },
        "rotation_deg": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rotation Deg"
        },
        "lens_mm": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 8,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lens Mm"
        },
        "easing": {
          "$ref": "#/$defs/Easing",
          "default": "ease_in_out"
        }
      },
      "required": [
        "frame",
        "location"
      ],
      "title": "CameraKey",
      "type": "object"
    },
    "CharacterInstance": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{1,47}$",
          "title": "Name",
          "type": "string"
        },
        "asset_id": {
          "pattern": "^[a-z][a-z0-9_]{1,47}$",
          "title": "Asset Id",
          "type": "string"
        },
        "transform": {
          "$ref": "#/$defs/Transform",
          "default": {
            "location": [
              0.0,
              0.0,
              0.0
            ],
            "rotation_deg": [
              0.0,
              0.0,
              0.0
            ],
            "scale": 1.0
          }
        },
        "motion_path": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TransformKey"
          },
          "title": "Motion Path",
          "type": "array"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/ActionClip"
          },
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        }
      },
      "required": [
        "name",
        "asset_id",
        "actions"
      ],
      "title": "CharacterInstance",
      "type": "object"
    },
    "Easing": {
      "enum": [
        "linear",
        "ease_in_out",
        "constant"
      ],
      "title": "Easing",
      "type": "string"
    },
    "Environment": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{1,47}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "hdri_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{1,47}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hdri Id"
        },
        "hdri_strength": {
          "default": 1.0,
          "maximum": 20,
          "minimum": 0,
          "title": "Hdri Strength",
          "type": "number"
        },
        "hdri_rotation_deg": {
          "default": 0.0,
          "title": "Hdri Rotation Deg",
          "type": "number"
        },
        "fog_density": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Fog Density",
          "type": "number"
        },
        "world_color": {
          "anyOf": [
            {
              "items": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "World Color"
        }
      },
      "title": "Environment",
      "type": "object"
    },
    "Framing": {
      "additionalProperties": false,
      "description": "v1.2. Where the look_at aim point sits in frame, as a fraction of the frame from its\ncentre: [x, y], +x right, +y up. [-1/6, 0] puts it on the left third line.",
      "properties": {
        "subject_offset": {
          "items": {
            "maximum": 0.4,
            "minimum": -0.4,
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Subject Offset",
          "type": "array"
        }
      },
      "required": [
        "subject_offset"
      ],
      "title": "Framing",
      "type": "object"
    },
    "Lighting": {
      "additionalProperties": false,
      "properties": {
        "preset": {
          "$ref": "#/$defs/LightingPreset",
          "default": "golden_hour"
        },
        "sun_elevation_deg": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -10,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sun Elevation Deg"
        },
        "sun_azimuth_deg": {
          "anyOf": [
            {
              "exclusiveMaximum": 360,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sun Azimuth Deg"
        },
        "sun_strength": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sun Strength"
        },
        "exposure": {
          "default": 0.0,
          "maximum": 5,
          "minimum": -5,
          "title": "Exposure",
          "type": "number"
        }
      },
      "title": "Lighting",
      "type": "object"
    },
    "LightingPreset": {
      "enum": [
        "golden_hour",
        "overcast",
        "midday",
        "blue_hour",
        "night"
      ],
      "title": "LightingPreset",
      "type": "string"
    },
    "Primitive": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{1,47}$",
          "title": "Name",
          "type": "string"
        },
        "shape": {
          "$ref": "#/$defs/PrimitiveShape"
        },
        "size": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Size",
          "type": "number"
        },
        "transform": {
          "$ref": "#/$defs/Transform",
          "default": {
            "location": [
              0.0,
              0.0,
              0.0
            ],
            "rotation_deg": [
              0.0,
              0.0,
              0.0
            ],
            "scale": 1.0
          }
        },
        "material": {
          "$ref": "#/$defs/PrimitiveMaterial",
          "default": {
            "base_color": [
              0.8,
              0.8,
              0.8
            ],
            "roughness": 0.5,
            "metallic": 0.0
          }
        },
        "keys": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PrimitiveKey"
          },
          "title": "Keys",
          "type": "array"
        }
      },
      "required": [
        "name",
        "shape"
      ],
      "title": "Primitive",
      "type": "object"
    },
    "PrimitiveKey": {
      "additionalProperties": false,
      "description": "A keyframe on a primitive. Only the channels given are keyed.",
      "properties": {
        "frame": {
          "minimum": 1,
          "title": "Frame",
          "type": "integer"
        },
        "location": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "rotation_deg": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rotation Deg"
        },
        "scale": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale"
        },
        "easing": {
          "$ref": "#/$defs/Easing",
          "default": "ease_in_out"
        }
      },
      "required": [
        "frame"
      ],
      "title": "PrimitiveKey",
      "type": "object"
    },
    "PrimitiveMaterial": {
      "additionalProperties": false,
      "properties": {
        "base_color": {
          "default": [
            0.8,
            0.8,
            0.8
          ],
          "items": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Base Color",
          "type": "array"
        },
        "roughness": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Roughness",
          "type": "number"
        },
        "metallic": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Metallic",
          "type": "number"
        }
      },
      "title": "PrimitiveMaterial",
      "type": "object"
    },
    "PrimitiveShape": {
      "enum": [
        "cube",
        "sphere",
        "cylinder",
        "cone",
        "plane"
      ],
      "title": "PrimitiveShape",
      "type": "string"
    },
    "PropInstance": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{1,47}$",
          "title": "Name",
          "type": "string"
        },
        "asset_id": {
          "pattern": "^[a-z][a-z0-9_]{1,47}$",
          "title": "Asset Id",
          "type": "string"
        },
        "transform": {
          "$ref": "#/$defs/Transform",
          "default": {
            "location": [
              0.0,
              0.0,
              0.0
            ],
            "rotation_deg": [
              0.0,
              0.0,
              0.0
            ],
            "scale": 1.0
          }
        },
        "parent": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{1,47}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "parent_bone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Bone"
        }
      },
      "required": [
        "name",
        "asset_id"
      ],
      "title": "PropInstance",
      "type": "object"
    },
    "RenderQuality": {
      "enum": [
        "animatic",
        "final"
      ],
      "title": "RenderQuality",
      "type": "string"
    },
    "RenderSettings": {
      "additionalProperties": false,
      "properties": {
        "quality": {
          "$ref": "#/$defs/RenderQuality",
          "default": "animatic"
        },
        "engine": {
          "default": "eevee",
          "enum": [
            "eevee",
            "cycles"
          ],
          "title": "Engine",
          "type": "string"
        },
        "resolution": {
          "default": [
            1920,
            1080
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Resolution",
          "type": "array"
        },
        "fps": {
          "default": 24,
          "enum": [
            24,
            25,
            30
          ],
          "title": "Fps",
          "type": "integer"
        },
        "frame_start": {
          "default": 1,
          "minimum": 1,
          "title": "Frame Start",
          "type": "integer"
        },
        "frame_end": {
          "default": 120,
          "minimum": 1,
          "title": "Frame End",
          "type": "integer"
        },
        "samples": {
          "default": 64,
          "maximum": 4096,
          "minimum": 1,
          "title": "Samples",
          "type": "integer"
        },
        "motion_blur": {
          "default": true,
          "title": "Motion Blur",
          "type": "boolean"
        },
        "seed": {
          "default": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "title": "RenderSettings",
      "type": "object"
    },
    "Shot": {
      "additionalProperties": false,
      "description": "v1.3: one camera over a contiguous range of the scene's single timeline. Cuts between\nshots come from the shared timeline, so the set and its motion stay continuous.",
      "properties": {
        "shot_id": {
          "pattern": "^[a-z][a-z0-9_]{1,47}$",
          "title": "Shot Id",
          "type": "string"
        },
        "frame_start": {
          "minimum": 1,
          "title": "Frame Start",
          "type": "integer"
        },
        "frame_end": {
          "minimum": 1,
          "title": "Frame End",
          "type": "integer"
        },
        "camera": {
          "$ref": "#/$defs/Camera"
        }
      },
      "required": [
        "shot_id",
        "frame_start",
        "frame_end",
        "camera"
      ],
      "title": "Shot",
      "type": "object"
    },
    "ShotSize": {
      "enum": [
        "extreme_wide",
        "wide",
        "medium",
        "close_up",
        "extreme_close_up"
      ],
      "title": "ShotSize",
      "type": "string"
    },
    "Transform": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Location",
          "type": "array"
        },
        "rotation_deg": {
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Rotation Deg",
          "type": "array"
        },
        "scale": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Scale",
          "type": "number"
        }
      },
      "title": "Transform",
      "type": "object"
    },
    "TransformKey": {
      "additionalProperties": false,
      "description": "A keyframe on an object's root (used for travel across the set).",
      "properties": {
        "frame": {
          "minimum": 1,
          "title": "Frame",
          "type": "integer"
        },
        "location": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Location",
          "type": "array"
        },
        "rotation_z_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rotation Z Deg"
        },
        "easing": {
          "$ref": "#/$defs/Easing",
          "default": "ease_in_out"
        }
      },
      "required": [
        "frame",
        "location"
      ],
      "title": "TransformKey",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "environment": {
            "anyOf": [
              {
                "properties": {
                  "asset_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "asset_id"
                ]
              },
              {
                "properties": {
                  "hdri_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "hdri_id"
                ]
              },
              {
                "properties": {
                  "world_color": {
                    "type": "array"
                  }
                },
                "required": [
                  "world_color"
                ]
              }
            ]
          }
        }
      },
      "if": {
        "properties": {
          "spec_version": {
            "const": "1.0"
          }
        }
      },
      "then": {
        "properties": {
          "primitives": {
            "maxItems": 0
          },
          "environment": {
            "anyOf": [
              {
                "properties": {
                  "asset_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "asset_id"
                ]
              },
              {
                "properties": {
                  "hdri_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "hdri_id"
                ]
              }
            ],
            "properties": {
              "world_color": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "spec_version": {
            "enum": [
              "1.0",
              "1.1"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "camera": {
            "properties": {
              "framing": {
                "type": "null"
              },
              "clip_start_m": {
                "type": "null"
              },
              "clip_end_m": {
                "type": "null"
              },
              "focus_distance_m": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "spec_version": {
            "enum": [
              "1.0",
              "1.1",
              "1.2"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "camera": {
            "type": "object"
          },
          "shots": {
            "type": "null"
          }
        },
        "required": [
          "camera"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "spec_version": {
            "const": "1.3"
          }
        },
        "required": [
          "spec_version"
        ]
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "camera": {
                "type": "object"
              },
              "shots": {
                "type": "null"
              }
            },
            "required": [
              "camera"
            ]
          },
          {
            "properties": {
              "shots": {
                "type": "array"
              },
              "camera": {
                "type": "null"
              }
            },
            "required": [
              "shots"
            ]
          }
        ]
      }
    }
  ],
  "properties": {
    "spec_version": {
      "default": "1.0",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3"
      ],
      "title": "Spec Version",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "scene_id": {
      "pattern": "^[a-z][a-z0-9_]{1,47}$",
      "title": "Scene Id",
      "type": "string"
    },
    "shot_id": {
      "pattern": "^[a-z][a-z0-9_]{1,47}$",
      "title": "Shot Id",
      "type": "string"
    },
    "description": {
      "maxLength": 600,
      "title": "Description",
      "type": "string"
    },
    "style_template": {
      "default": "spring_style",
      "pattern": "^[a-z][a-z0-9_]{1,47}$",
      "title": "Style Template",
      "type": "string"
    },
    "render": {
      "$ref": "#/$defs/RenderSettings",
      "default": {
        "quality": "animatic",
        "engine": "eevee",
        "resolution": [
          1920,
          1080
        ],
        "fps": 24,
        "frame_start": 1,
        "frame_end": 120,
        "samples": 64,
        "motion_blur": true,
        "seed": 0
      }
    },
    "environment": {
      "$ref": "#/$defs/Environment"
    },
    "lighting": {
      "$ref": "#/$defs/Lighting",
      "default": {
        "preset": "golden_hour",
        "sun_elevation_deg": null,
        "sun_azimuth_deg": null,
        "sun_strength": null,
        "exposure": 0.0
      }
    },
    "characters": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CharacterInstance"
      },
      "title": "Characters",
      "type": "array"
    },
    "props": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PropInstance"
      },
      "title": "Props",
      "type": "array"
    },
    "primitives": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Primitive"
      },
      "title": "Primitives",
      "type": "array"
    },
    "camera": {
      "anyOf": [
        {
          "$ref": "#/$defs/Camera"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "shots": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Shot"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Shots"
    }
  },
  "required": [
    "project_id",
    "scene_id",
    "shot_id",
    "description",
    "environment"
  ],
  "title": "SceneSpec",
  "type": "object"
}
